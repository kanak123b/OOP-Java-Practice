abstract class Instrument{
  abstract void play();
  abstract void tune();
}

class Glockenspiel extends Instrument{
  @Override
  void play(){
  System.out.println("Playing the notes on the metal bars.");
  }

  @Override
  void tune(){
    System.out.println("Tuning the metal bars to the correct pitch.");
  }
}

class Violon extends Instrument{
  @Override
  void play(){
    System.out.println("Playing the strings with a bow or fingers.");
  }

  @Override
  void tune(){
    System.out.println("Tuning the strings to the correct pitch.");
  }
}

public class Main{
  public static void main(String[] args){
    Instrument glockenspiel = new Glockenspiel();
    Instrument violon = new Violon();

    glockenspiel.play();
    glockenspiel.tune();

    violon.play();
    violon.tune();


  }
}
